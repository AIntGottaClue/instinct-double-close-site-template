---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import { home } from '../data/city';
import { brand, domain, cities, site } from '../data/city';

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": brand,
    "url": `https://${domain}/`
  },
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "@id": `https://${domain}/#business`,
    "name": brand,
    "url": `https://${domain}/`,
    "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name, "containedInPlace": { "@type": "State", "name": site.state } })),
    "description": site.serviceDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": site.serviceType,
    "provider": { "@id": `https://${domain}/#business` },
    "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name, "containedInPlace": { "@type": "State", "name": site.state } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": home.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---
<Base title={home.title} description={home.description} path="/" jsonld={jsonld}>
  <Header base="" />
  <main>
    <CityContent
      h1Bottom={home.h1Bottom}
      hero={home.hero}
      localNoteTitle={home.localNoteTitle}
      localNote={home.localNote}
      whyHeading={home.whyHeading}
      why={home.why}
      steps={home.steps}
      faqs={home.faqs}
      formName={home.formName}
      cityName={site.ui.legalCityName}
      location="Homepage"
      showCityGrid={true}
    />
  </main>
  <Footer />
</Base>

