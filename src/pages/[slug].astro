---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import { cities, brand, domain, site } from '../data/city';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { slug: c.slug }, props: { city: c } }));
}
const { city } = Astro.props;

const businessId = `https://${domain}/#business`;
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "@id": businessId,
    "name": brand,
    "url": `https://${domain}/`,
    "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name, "containedInPlace": { "@type": "State", "name": site.state } })),
    "description": site.serviceDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": site.serviceType,
    "provider": { "@id": businessId },
    "areaServed": { "@type": "City", "name": city.name, "containedInPlace": { "@type": "State", "name": site.state } }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": city.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://${domain}/` },
      { "@type": "ListItem", "position": 2, "name": `${city.name}, ${site.region}`, "item": `https://${domain}/${city.slug}/` }
    ]
  }
];
---
<Base title={city.title} description={city.description} path={`/${city.slug}/`} jsonld={jsonld}>
  <Header base={`/${city.slug}`} />
  <main>
    <CityContent
      h1Bottom={city.h1Bottom}
      hero={city.hero}
      localNoteTitle={city.localNoteTitle}
      localNote={city.localNote}
      whyHeading={city.whyHeading}
      why={city.why}
      steps={city.steps}
      faqs={city.faqs}
      formName={city.formName}
      cityName={city.name}
      location={`${city.name}, ${site.region}`}
      summaryFees={city.summaryFees}
      summarySteps={city.summarySteps}
      scenario={city.scenario}
    />
  </main>
  <Footer />
</Base>

