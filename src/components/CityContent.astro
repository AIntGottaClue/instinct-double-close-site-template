---
import { trustBar, fees, cities, site } from '../data/city';
import type { Step, Faq, Scenario } from '../data/city';
import DealForm from './DealForm.astro';
import FaqAccordion from './FaqAccordion.astro';
interface Props { h1Bottom:string;hero:string;localNoteTitle:string;localNote:string;whyHeading:string;why:string[];steps:Step[];faqs:Faq[];formName:string;cityName:string;location:string;showCityGrid?:boolean;summaryFees?:boolean;summarySteps?:boolean;scenario?:Scenario; }
const {h1Bottom,hero,localNoteTitle,localNote,whyHeading,why,steps,faqs,formName,cityName,location,showCityGrid=false,summaryFees=false,summarySteps=false,scenario}=Astro.props;
const nearbyCities = showCityGrid ? [] : (cities.find(c=>c.name===cityName)?.nearby ?? []).map(slug=>cities.find(c=>c.slug===slug)).filter(Boolean);
---
<section class="hero" aria-labelledby="hero-title"><div class="hero__graphic" aria-hidden="true"><span class="hero__stripe hero__stripe--1"></span><span class="hero__stripe hero__stripe--2"></span><span class="hero__stripe hero__stripe--3"></span></div><div class="container hero__inner"><div class="hero__content"><h1 class="hero__title" id="hero-title"><span class="hero__line">{site.nicheTitle}</span><span class="hero__line hero__line--accent">{h1Bottom}</span></h1><p class="hero__subtitle">{hero}</p></div><DealForm formName={formName} cityName={cityName} location={location} /></div></section>
<section class="trust-bar" aria-label="Funding highlights"><div class="container trust-bar__inner">{trustBar.map(t=><div class="trust-bar__item"><span class="trust-bar__icon" aria-hidden="true">✓</span>{t}</div>)}</div></section>
{summaryFees ? (
<section class="section" id="funding-fees"><div class="container"><p class="section__kicker">Funding Fees</p><h2 class="section__title">Clear fees. No surprises.</h2><p class="section__intro" set:html={site.ui.feesIntroSummary}></p></div></section>
) : (
<section class="section" id="funding-fees"><div class="container"><p class="section__kicker">Funding Fees</p><h2 class="section__title">Clear fees. No surprises.</h2><p class="section__intro" set:html={site.ui.feesIntroFull}></p><div class="funding-fees__layout"><div class="fee-table-wrap"><table class="fee-table"><caption class="sr-only">Double-close funding fee schedule</caption><thead><tr><th scope="col">Funding Amount</th><th scope="col">Fee or Detail</th></tr></thead><tbody>{fees.map(f=><tr><th scope="row">{f.label}</th><td>{f.detail}</td></tr>)}</tbody></table></div></div></div></section>
)}
<section class="local-note" aria-labelledby="local-note-title"><div class="container local-note__inner"><div class="local-note__marker" aria-hidden="true">{site.region}</div><div class="local-note__body"><h2 class="local-note__title" id="local-note-title">{localNoteTitle}</h2><p>{localNote}</p></div></div></section>
<section class="why-us section" id="why-us"><div class="container"><p class="section__kicker">Why Us</p><h2 class="section__title">{whyHeading}</h2><p class="why-us__intro">{why[0]}</p><div class="why-us__grid">{why.slice(1).map((text,i)=><article class="feature-card"><div class="feature-card__icon" aria-hidden="true">{String(i+1).padStart(2,'0')}</div><p class="feature-card__text">{text}</p></article>)}</div></div></section>
{summarySteps ? (
<section class="section section--dark" id="how-it-works"><div class="container"><p class="section__kicker">How It Works</p><h2 class="section__title">Three steps from contract to close</h2><p class="section__intro section__intro--dark" set:html={site.ui.howItWorksIntroHome}></p></div></section>
) : (
<section class="section section--dark" id="how-it-works"><div class="container"><p class="section__kicker">How It Works</p><h2 class="section__title">Three steps from contract to close</h2><p class="section__intro section__intro--dark" set:html={site.ui.howItWorksIntroCity}></p><ol class="steps">{steps.map((s,i)=><li class="step"><span class="step__num">{i+1}</span><h3 class="step__title">{s.title}</h3><p class="step__text">{s.text}</p></li>)}</ol></div></section>
)}
{scenario && <section class="section scenario" id="local-checklist"><div class="container"><h2 class="section__title">{scenario.title}</h2><p class="section__intro">{scenario.intro}</p><ol class="scenario__list">{scenario.items.map(item=><li>{item}</li>)}</ol><p class="scenario__outro">{scenario.outro}</p></div></section>}
<section class="section section--tint" id="faq"><div class="container faq__inner"><p class="section__kicker">FAQ</p><h2 class="section__title">Questions wholesalers ask</h2><FaqAccordion items={faqs} /></div></section>
{showCityGrid&&<section class="section" id="service-areas"><div class="container"><p class="section__kicker">Service Areas</p><h2 class="section__title">{site.ui.serviceAreasTitle}</h2><p class="section__intro">{site.ui.serviceAreasIntro}</p><div class="city-grid">{cities.map(c=><a class="city-card" href={`/${c.slug}/`}><h3>{c.name}</h3><p class="city-card__county">{c.county} County</p><p>{c.blurb}</p></a>)}</div></div></section>}
{nearbyCities.length>0&&<section class="nearby" aria-label="Nearby service areas"><div class="container nearby__inner"><h2 class="nearby__title">Nearby service areas</h2><ul class="nearby__list">{nearbyCities.map(c=><li><a href={`/${c.slug}/`}>{c.name}, {site.region}</a></li>)}</ul></div></section>}
<section class="final-cta"><div class="final-cta__graphic" aria-hidden="true"></div><div class="container final-cta__inner"><h2 class="final-cta__title">Ready to fund your {cityName} double closing?</h2><p class="final-cta__text">Submit the deal and we will review the numbers. Funding can be ready in as little as 24 hours once we have the deal details and closing office information.</p><a class="btn btn--accent btn--lg" href="#deal-form">Submit Your Deal <span aria-hidden="true">→</span></a></div></section>
